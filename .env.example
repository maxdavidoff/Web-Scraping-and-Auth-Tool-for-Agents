# Copy this file to .env and fill in local-only values.
# Do not commit .env or provider session state files.

# Optional for provider-neutral intent extraction.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Live tests are opt-in. Leave unset/0 for normal local and CI runs.
RUN_LIVE_LLM_TESTS=0
RUN_LIVE_SCRAPE_TESTS=0

# Optional defaults. You can also pass these through CLI args.
OHANA_START_URL=https://liveohana.ai/
OHANA_SEARCH_URL=https://liveohana.ai/
OHANA_LOCATION=Philadelphia

AFFORDABLEHOUSING_START_URL=https://www.affordablehousing.com/
AFFORDABLEHOUSING_SEARCH_URL=https://www.affordablehousing.com/
AFFORDABLEHOUSING_LOCATION=Boston, MA

RENTALSOURCE_START_URL=https://www.rentalsource.com/
RENTALSOURCE_SEARCH_URL=https://www.rentalsource.com/
RENTALSOURCE_LOCATION=Boston, MA
